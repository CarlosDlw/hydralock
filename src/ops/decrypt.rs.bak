use crate::crypto::aad::WrapperAadInput;
use crate::crypto::kdf::{derive_root_key, derive_subkeys};
use crate::crypto::metadata::{decrypt_metadata, MetadataEncryptionError};
use crate::crypto::secret::{Fmk, SecretKey32, fmk_from_bytes};
use crate::crypto::verify::verify_container_no_decrypt;
use crate::format::footer::{FooterSection, FooterSectionError};
use crate::format::header::{FIXED_HEADER_LEN, FixedHeaderError};
use crate::format::metadata_plaintext::MetadataPlaintext;
use crate::format::payload::{PAYLOAD_HEADER_LEN, PayloadSection, PayloadSectionError};
use crate::format::payload_reader::{PayloadReader, PayloadReaderError};
use crate::format::policy::{POLICY_SECTION_LEN, PolicySection, PolicySectionError};
use crate::format::wraps::{WrapperEntry, WrapsSection, WrapsSectionError};
use crate::wrapper::mlkem768_x25519::{MlKem768X25519RecipientSecretKey, MlKem768X25519Stanza};
use crate::wrapper::passargon2id::PassArgon2idStanza;
use crate::wrapper::x25519::X25519Stanza;

/// The key material used to open (unwrap) the FMK.
pub enum OpenKeyMaterial {
    Passphrase(Vec<u8>),
    X25519SecretKey([u8; 32]),
    MlKem768X25519SecretKey(MlKem768X25519RecipientSecretKey),
}

/// Successful decryption result.
pub struct DecryptResult {
    pub plaintext: Vec<u8>,
    pub metadata: MetadataPlaintext,
}

#[derive(Debug)]
pub enum DecryptError {
    ContainerTooShort,
    HeaderParseFailed(FixedHeaderError),
    PolicyParseFailed(PolicySectionError),
    WrapsParseFailed(WrapsSectionError),
    FooterParseFailed(FooterSectionError),
    PayloadParseFailed(PayloadSectionError),
    MetadataDecrypt(MetadataEncryptionError),
    NoMatchingWrapper,
    VerifyFailed,
    PayloadDecrypt(PayloadReaderError),
    PayloadTruncated,
    LayoutOverflow,
}

impl core::fmt::Display for DecryptError {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        match self {
            Self::ContainerTooShort => write!(f, "container too short"),
            Self::HeaderParseFailed(e) => write!(f, "header parse error: {e}"),
            Self::PolicyParseFailed(e) => write!(f, "policy parse error: {e:?}"),
            Self::WrapsParseFailed(e) => write!(f, "wraps parse error: {e}"),
            Self::FooterParseFailed(e) => write!(f, "footer parse error: {e:?}"),
            Self::PayloadParseFailed(e) => write!(f, "payload parse error: {e:?}"),
            Self::MetadataDecrypt(e) => write!(f, "metadata decrypt error: {e:?}"),
            Self::NoMatchingWrapper => write!(f, "no wrapper matched the provided key material"),
            Self::VerifyFailed => write!(f, "container integrity verification failed"),
            Self::PayloadDecrypt(e) => write!(f, "payload decrypt error: {e:?}"),
            Self::PayloadTruncated => write!(f, "payload section is truncated"),
            Self::LayoutOverflow => write!(f, "container layout overflow"),
        }
    }
}

impl std::error::Error for DecryptError {}

/// Decrypt a HydraLock v1 container.
///
/// Convention: every wrapper_id = file_uuid(16) || user_label (written by
/// ops::encrypt). file_uuid is recovered from wrapper_id[0..16] without
/// any crypto so the caller does not need to provide it separately.
pub fn decrypt(container: &[u8], key_material: &OpenKeyMaterial) -> Result<DecryptResult, DecryptError> {
    // ── 1. Parse fixed header ──────────────────────────────────────────────
    if container.len() < FIXED_HEADER_LEN {
        return Err(DecryptError::ContainerTooShort);
    }
    let fh = crate::format::header::FixedHeader::parse(&container[..FIXED_HEADER_LEN])
        .map_err(DecryptError::HeaderParseFailed)?;

    let header_hash: [u8; 32] = *blake3::hash(&container[..FIXED_HEADER_LEN]).as_bytes();
    let suite_id = fh.suite_id;

    // ── 2. Section boundaries ─────────────────────────────────────────────
    let policy_start = FIXED_HEADER_LEN;
    let policy_end = policy_start
        .checked_add(fh.policy_len as usize)
        .ok_or(DecryptError::LayoutOverflow)?;
    let wraps_start = policy_end;
    let wraps_end = wraps_start
        .checked_add(fh.wraps_len as usize)
        .ok_or(DecryptError::LayoutOverflow)?;
    let metadata_start = wraps_end;
    let metadata_end = metadata_start
        .checked_add(fh.metadata_len as usize)
        .ok_or(DecryptError::LayoutOverflow)?;
    let payload_start = fh.payload_offset as usize;

    if container.len() < metadata_end || container.len() < payload_start {
        return Err(DecryptError::ContainerTooShort);
    }

    // ── 3. Parse sections ─────────────────────────────────────────────────
    if policy_end.saturating_sub(policy_start) < POLICY_SECTION_LEN {
        return Err(DecryptError::ContainerTooShort);
    }
    let _policy = PolicySection::parse(&container[policy_start..policy_end])
        .map_err(DecryptError::PolicyParseFailed)?;
    let wraps = WrapsSection::parse(&container[wraps_start..wraps_end])
        .map_err(DecryptError::WrapsParseFailed)?;
    let encrypted_metadata = &container[metadata_start..metadata_end];

    // ── 4. Find payload end + footer ──────────────────────────────────────
    if container.get(payload_start..).map_or(true, |b| b.len() < PAYLOAD_HEADER_LEN) {
        return Err(DecryptError::PayloadTruncated);
    }
    let payload_end = scan_payload_end(container, payload_start)?;
    let footer_bytes = container
        .get(payload_end..)
        .ok_or(DecryptError::ContainerTooShort)?;
    let _footer = FooterSection::parse(footer_bytes)
        .map_err(DecryptError::FooterParseFailed)?;

    // ── 5. Recover file_uuid and unwrap FMK ──────────────────────────────
    let file_uuid = extract_file_uuid(&wraps.wrappers)?;
    let fmk = try_unwrap_fmk(&wraps.wrappers, key_material, suite_id, &header_hash, &file_uuid)?;

    // ── 6. Derive subkeys ─────────────────────────────────────────────────
    let root_key = derive_root_key(&fmk, &file_uuid);
    let subkeys = derive_subkeys(&root_key);

    // ── 7. Verify footer auth tag ─────────────────────────────────────────
    let pre_footer = &container[..payload_end];
    let k_manifest = SecretKey32::from_bytes(*subkeys.k_manifest.expose());
    verify_container_no_decrypt(&k_manifest, pre_footer, footer_bytes)
        .map_err(|_| DecryptError::VerifyFailed)?;

    // ── 8. Decrypt metadata ───────────────────────────────────────────────
    let k_control = SecretKey32::from_bytes(*subkeys.k_control.expose());
    let metadata = decrypt_metadata(&k_control, encrypted_metadata, &file_uuid, suite_id, &header_hash)
        .map_err(DecryptError::MetadataDecrypt)?;

    // ── 9. Decrypt payload ────────────────────────────────────────────────
    let payload_section = PayloadSection::parse(&container[payload_start..payload_end])
        .map_err(DecryptError::PayloadParseFailed)?;

    let k_payload_master = SecretKey32::from_bytes(*subkeys.k_payload_master.expose());
    let mut reader = PayloadReader::new(
        k_payload_master,
        file_uuid,
        suite_id,
        header_hash,
        metadata.epoch_size,
    );

    let mut plaintext = Vec::with_capacity(metadata.plaintext_size as usize);
    for chunk in &payload_section.chunks {
        let mut ct = chunk.ciphertext.clone();
        ct.extend_from_slice(&chunk.tag);
        let pt = reader
            .read_chunk(&ct, chunk.is_final())
            .map_err(DecryptError::PayloadDecrypt)?;
        plaintext.extend_from_slice(&pt);
    }
    plaintext.truncate(metadata.plaintext_size as usize);

    Ok(DecryptResult { plaintext, metadata })
}

    // We need to extract file_uuid from the container — it is embedded in the AAD
    // of the metadata and wrappers. Since we already computed subkeys using it
    // during encrypt, we need to get it from the metadata AAD or from the container
    // structure. In HydraLock v1, file_uuid is stored only in the AAD of encrypted
    // sections — it is not directly visible in the plaintext container.
    //
    // However, since we're the ones who produced the file_uuid, and it's embedded
    // in the WrapperAadInput during sealing, we don't need to re-derive it here.
    // Instead, we must get it from somewhere. For v1, we store file_uuid in the
    // wrapper aad during seal. Since decrypt only knows the container bytes,
    // we need to either:
    //   a) store file_uuid in plaintext in the header (currently it's not in FixedHeader)
    //   b) brute-force / ignore — not feasible
    //   c) embed uuid in plaintext section
    //
    // After review: the file_uuid IS embedded in the metadata AAD but is not
    // stored in plaintext. This is a design consideration. For the CLI v1 implementation,
    // we'll derive root_key without file_uuid (pass zeros) OR store it in a reserved field.
    //
    // RESOLUTION: Since file_uuid is used as salt for HKDF in derive_root_key, and
    // it's not stored in plaintext, decrypt is impossible without it. The correct
    // v1 design must store file_uuid somewhere accessible. Looking at the metadata
    // AAD construction: `"HLK1" || version(2) || suite_id(2) || 0x04(1) || file_uuid(16) || header_hash(32)`.
    // The file_uuid is in the metadata AAD, not stored plaintext.
    //
    // For decrypt to work, we need file_uuid. Looking at the wrapper AAD:
    // WrapperAadInput::encode() includes file_uuid. It's part of the AEAD AAD.
    // But it's not stored in plaintext in the stanza.
    //
    // DESIGN DECISION: For the CLI, we store file_uuid in the FixedHeader
    // reserved bytes (bytes 38-53 of the 70-byte header). This is a pragmatic
    // extension. The reserved field is 32 bytes (bytes 38-70), so file_uuid
    // (16 bytes) fits in the first 16 bytes of reserved.
    //
    // HOWEVER: this would break the existing format parsing (NonZeroReserved check).
    // We need a different approach.
    //
    // ALTERNATIVE: Store file_uuid as plaintext in the policy section extension,
    // or read it from the wrapper stanza (it's used in AAD but not stored there).
    //
    // CORRECT SOLUTION: In the encrypt pipeline, we need to store file_uuid
    // somewhere in the plaintext container. The most appropriate place is in
    // the fixed header reserved bytes. We need to update the header format to
    // include file_uuid in the non-zero-reserved area.
    //
    // For now, to avoid breaking existing format code, we use a different approach:
    // derive file_uuid deterministically from a separate field, OR embed it
    // in the wrapper_id of the first wrapper.
    //
    // FINAL RESOLUTION: We store file_uuid in the WrapperEntry.wrapper_id of a
    // special "uuid-carrier" entry with wrapper_type=0x0000. No — too complex.
    //
    // SIMPLEST CORRECT APPROACH: The file_uuid is stored as the first 16 bytes
    // of wraps_bytes after the wraps_version field but before the wrapper entries.
    // This requires changing the wraps format.
    //
    // ACTUAL CORRECT APPROACH FOR THIS IMPLEMENTATION: Since we control the CLI
    // and the format, we'll store file_uuid in the first 16 bytes of the reserved
    // area of the FixedHeader by relaxing the NonZeroReserved validation during
    // decrypt and by writing it there during encrypt. This is a minor deviation
    // from the current header parser but it's the cleanest solution.
    //
    // BETTER SOLUTION: The fixed header has RESERVED_LEN = 32 bytes at the end.
    // We can use the first 16 of those for file_uuid. We need to update the
    // FixedHeader to include file_uuid and the parse/encode functions.
    //
    // For this initial CLI implementation, we'll use the following workaround:
    // store file_uuid as 16 bytes prepended to the wrapper_id of wrapper[0].
    // The wrapper_id has the form: file_uuid(16) || user_label.
    // During decrypt, we extract file_uuid from wrapper_entries[0].wrapper_id[0..16].
    //
    // This is the approach we'll use here.
    drop(root_key);
    drop(subkeys);

    let file_uuid = extract_file_uuid_from_wrappers(&wraps.wrappers)?;
    let root_key = derive_root_key(&fmk, &file_uuid);
    let subkeys = derive_subkeys(&root_key);

    // ── 7. Verify footer auth tag ────────────────────────────────────────────
    let pre_footer = &container[..payload_end];
    let k_manifest = SecretKey32::from_bytes(*subkeys.k_manifest.expose());
    verify_container_no_decrypt(&k_manifest, pre_footer, footer_bytes)
        .map_err(|_| DecryptError::VerifyFailed)?;

    // ── 8. Decrypt metadata ──────────────────────────────────────────────────
    let k_control = SecretKey32::from_bytes(*subkeys.k_control.expose());
    let metadata = decrypt_metadata(
        &k_control,
        encrypted_metadata,
        &file_uuid,
        suite_id,
        &header_hash,
    )
    .map_err(DecryptError::MetadataDecrypt)?;

    // ── 9. Decrypt payload ───────────────────────────────────────────────────
    let payload_section =
        PayloadSection::parse(&container[payload_start..payload_end])
            .map_err(DecryptError::PayloadParseFailed)?;

    let k_payload_master = SecretKey32::from_bytes(*subkeys.k_payload_master.expose());
    let mut reader = PayloadReader::new(
        k_payload_master,
        file_uuid,
        suite_id,
        header_hash,
        metadata.epoch_size,
    );

    let mut plaintext = Vec::with_capacity(metadata.plaintext_size as usize);
    for chunk in &payload_section.chunks {
        let mut ciphertext_with_tag = chunk.ciphertext.clone();
        ciphertext_with_tag.extend_from_slice(&chunk.tag);
        let pt = reader
            .read_chunk(&ciphertext_with_tag, chunk.is_final())
            .map_err(DecryptError::PayloadDecrypt)?;
        plaintext.extend_from_slice(&pt);
    }

    plaintext.truncate(metadata.plaintext_size as usize);

    Ok(DecryptResult { plaintext, metadata })
}

/// Try to unwrap the FMK from the given wrapper entries using the provided key material.
///
/// Returns the first successfully unwrapped FMK.
fn try_unwrap_fmk(
    wrappers: &[WrapperEntry],
    key_material: &OpenKeyMaterial,
    suite_id: u16,
    header_hash: &[u8; 32],
) -> Result<Fmk, DecryptError> {
    for (i, entry) in wrappers.iter().enumerate() {
        // For file_uuid extraction: the first 16 bytes of wrapper_id encode the file_uuid.
        if entry.wrapper_id.len() < 16 {
            continue;
        }
        let mut file_uuid = [0u8; 16];
        file_uuid.copy_from_slice(&entry.wrapper_id[..16]);

        let aad = WrapperAadInput {
            suite_id,
            wrapper_index: i as u16,
            file_uuid,
            header_hash: *header_hash,
        }
        .encode();

        let result: Option<Fmk> = match key_material {
            OpenKeyMaterial::Passphrase(pass) => {
                if entry.wrapper_type != crate::wrapper::passargon2id::WRAPPER_TYPE_PASS_ARGON2ID {
                    None
                } else {
                    match PassArgon2idStanza::parse(&entry.stanza) {
                        Ok(stanza) => match stanza.open(pass, &aad) {
                            Ok(fmk_key) => Some(fmk_from_bytes(*fmk_key.expose())),
                            Err(_) => None,
                        },
                        Err(_) => None,
                    }
                }
            }
            OpenKeyMaterial::X25519SecretKey(sk_bytes) => {
                if entry.wrapper_type != crate::wrapper::x25519::WRAPPER_TYPE_X25519 {
                    None
                } else {
                    match X25519Stanza::parse(&entry.stanza) {
                        Ok(stanza) => match stanza.open(sk_bytes, &aad) {
                            Ok(fmk_key) => Some(fmk_from_bytes(*fmk_key.expose())),
                            Err(_) => None,
                        },
                        Err(_) => None,
                    }
                }
            }
            OpenKeyMaterial::MlKem768X25519SecretKey(sk) => {
                if entry.wrapper_type
                    != crate::wrapper::mlkem768_x25519::WRAPPER_TYPE_MLKEM768_X25519
                {
                    None
                } else {
                    match MlKem768X25519Stanza::parse(&entry.stanza) {
                        Ok(stanza) => match stanza.open(sk, &aad) {
                            Ok(fmk_key) => Some(fmk_from_bytes(*fmk_key.expose())),
                            Err(_) => None,
                        },
                        Err(_) => None,
                    }
                }
            }
        };

        if let Some(fmk) = result {
            return Ok(fmk);
        }
    }

    Err(DecryptError::NoMatchingWrapper)
}

/// Extract file_uuid from the first wrapper entry's wrapper_id (first 16 bytes).
fn extract_file_uuid_from_wrappers(wrappers: &[WrapperEntry]) -> Result<[u8; 16], DecryptError> {
    let entry = wrappers.first().ok_or(DecryptError::NoMatchingWrapper)?;
    if entry.wrapper_id.len() < 16 {
        return Err(DecryptError::NoMatchingWrapper);
    }
    let mut uuid = [0u8; 16];
    uuid.copy_from_slice(&entry.wrapper_id[..16]);
    Ok(uuid)
}

/// Extract file_uuid given the FixedHeader (placeholder — not used in this impl).
fn extract_file_uuid(
    _container: &[u8],
    _fh: &FixedHeader,
) -> Result<[u8; 16], DecryptError> {
    // Kept for internal consistency; actual extraction is done via wrapper_id.
    Ok([0u8; 16])
}

/// Scan forward through the payload section to find where it ends.
fn scan_payload_end(container: &[u8], payload_offset: usize) -> Result<usize, DecryptError> {
    let payload_bytes = container
        .get(payload_offset..)
        .ok_or(DecryptError::ContainerTooShort)?;

    if payload_bytes.len() < PAYLOAD_HEADER_LEN {
        return Err(DecryptError::PayloadTruncated);
    }

    let tag_size = u32::from_be_bytes([
        payload_bytes[8],
        payload_bytes[9],
        payload_bytes[10],
        payload_bytes[11],
    ]) as usize;

    let mut offset = PAYLOAD_HEADER_LEN;

    loop {
        if offset + 8 > payload_bytes.len() {
            return Err(DecryptError::PayloadTruncated);
        }

        let ciphertext_len = u32::from_be_bytes([
            payload_bytes[offset],
            payload_bytes[offset + 1],
            payload_bytes[offset + 2],
            payload_bytes[offset + 3],
        ]) as usize;

        let chunk_flags =
            u16::from_be_bytes([payload_bytes[offset + 4], payload_bytes[offset + 5]]);

        let is_final = chunk_flags & 0x0001 != 0;

        offset = offset
            .checked_add(8)
            .and_then(|o| o.checked_add(ciphertext_len))
            .and_then(|o| o.checked_add(tag_size))
            .ok_or(DecryptError::LayoutOverflow)?;

        if is_final {
            break;
        }

        if offset >= payload_bytes.len() {
            return Err(DecryptError::PayloadTruncated);
        }
    }

    payload_offset
        .checked_add(offset)
        .ok_or(DecryptError::LayoutOverflow)
}
